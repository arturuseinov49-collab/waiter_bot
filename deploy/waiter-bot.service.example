[Unit]
Description=Restaurant staff training bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/waiter_bot
ExecStart=/root/waiter_bot/venv/bin/python bot.py
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
